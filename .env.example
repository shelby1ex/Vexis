# ---------------------------------------------------------------------------
# VEXIS AI PLATFORM 1.0 — environment template
# Copy to `.env` and fill in your own values. NEVER commit the real `.env`.
# All secrets come from here (or the host env) — never from source files.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Flask session signing key (openssl rand -hex 32). Required in production.
VEXIS_SECRET_KEY=change-me-to-a-long-random-hex

# Writable data dir (avatars, generated PDFs/ZIPs). Optional on hosts with a
# writable app dir; set it on read-only-fs platforms (Belmo) to a VOLUME.
VEXIS_DATA_DIR=/app/data

# --- Database: local SQLite only ----------------------------------------------
# No DATABASE_URL on purpose. The app uses vexis.db (SQLite) in the app dir.
# Nothing cloud, nothing to configure. (Postgres/Neon support removed.)

# --- AI provider keys (openrouter.ai / any OpenAI-compatible provider) -------
# Primary key. Backup keys: comma-separated list. Round-robin spreads the
# free-tier daily cap across every key.
VEXIS_PRIMARY_KEY=
VEXIS_BACKUP_API_KEYS=
# Provider type for the env keys above: custom (default), openai, anthropic,
# nvidia, opencode. When opencode, OPENROUTER_BASE defaults to Zen.
VEXIS_PROVIDER_TYPE=custom

# --- OpenCode backend (opencode app as provider) -----------------------------
# OpenCode Zen is OpenAI-compatible (https://opencode.ai/zen/v1).
# Option A (dedicated, tried first): set VEXIS_OPENCODE_KEY only.
# Option B: VEXIS_PROVIDER_TYPE=opencode + VEXIS_PRIMARY_KEY=<zen key>.
VEXIS_OPENCODE_KEY=
VEXIS_OPENCODE_BASE=https://opencode.ai/zen/v1
VEXIS_OPENCODE_MODEL=

# --- OpenCode APP (Vexis UI on the real OpenCode app) -------------------------
# The chat stream creates one OpenCode app session per Vexis chat and its
# native tools (bash/read/edit/webfetch/...) run inside OpenCode.
# 1 = on (default). The app server auto-starts when unreachable.
VEXIS_OPENCODE_APP=1
VEXIS_OPENCODE_APP_URL=http://127.0.0.1:4096
VEXIS_OPENCODE_APP_PORT=4096

# --- freeBuff local tools (no keys, no network) ------------------------------
# Always on: calc, text stats, uuid, password, base64, json.
# Chat auto-injects FREEBUFF blocks; direct calls: POST /api/freebuff/execute
# with {tool: calc|text|uuid|password|base64|json, arg: "..."}.
VEXIS_FREEBUFF_ENABLED=1

# --- Free fallbacks (no credit card) -----------------------------------------
# Tried automatically when every key above fails/exhausts its quota.
# Gemini free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Cloudflare Workers AI: account id + API token (Workers AI REST).
VEXIS_CF_ACCOUNT_ID=
VEXIS_CF_API_TOKEN=

# --- Google OAuth (Sign in with Google) — optional ---------------------------
VEXIS_GOOGLE_CLIENT_ID=
VEXIS_GOOGLE_CLIENT_SECRET=
# Plain alias also accepted (matches Google's client_secret download field):
GOOGLE_CLIENT_SECRET=

# --- Connectors (Settings -> Connections) — real OAuth, free tiers ----------
# GitHub OAuth app: https://github.com/settings/developers
VEXIS_GITHUB_CLIENT_ID=
VEXIS_GITHUB_CLIENT_SECRET=
# Facebook/Instagram app: https://developers.facebook.com/apps
VEXIS_FB_CLIENT_ID=
VEXIS_FB_CLIENT_SECRET=
# Microsoft app: https://portal.azure.com -> App registrations
VEXIS_OUTLOOK_CLIENT_ID=
VEXIS_OUTLOOK_CLIENT_SECRET=
# --- Admin-managed services (Vexis Watchdog -> External AI Keys) -----------
# PREFER the admin panel over these variables: keys saved in Watchdog are
# encrypted at rest and apply to EVERY user immediately. These variables are
# only a fallback for self-hosted setups with no admin access.
#
#   Watchdog -> External AI Keys provides:
#     pollination           Pollinations.ai image generation (free)
#     openweather           weather tool for all users   (free, 1000/day)
#     newsapi               news tool for all users      (free, 100/day)
#     google_client_id      enables "Continue with Google" on the login page
#     google_client_secret
#     whatsapp_token        Meta Cloud API -> real WhatsApp messages
#     whatsapp_phone_id
#     elevenlabs_stt / elevenlabs_tts / openai_whisper / deepgram   voice
VEXIS_WEATHER_API_KEY=  # fallback only: openweathermap.org (1000 calls/day)
VEXIS_NEWS_API_KEY=  # fallback only: newsapi.org (100 requests/day)

# Google OAuth ("Continue with Google"). Leave both blank and set them in
# Watchdog instead. The redirect URI Google must allow is:
#   <VEXIS_BASE_URL>/api/auth/google/callback
VEXIS_GOOGLE_CLIENT_ID=
VEXIS_GOOGLE_CLIENT_SECRET=

# WhatsApp via the Meta Cloud API (free test tier, no card). Admin panel is
# preferred; these are fallbacks. The recipient number needs its country code.
VEXIS_WHATSAPP_TOKEN=
VEXIS_WHATSAPP_PHONE_ID=

# Image generator (Pollinations). Prefer the Watchdog "pollination" key; the
# endpoint also works anonymously at ~1 image / 15s per IP.
VEXIS_POLLINATION_BASE=https://image.pollinations.ai/prompt
# Optional env fallback for the Pollinations key. ai.py currently reads this
# only from the admin panel (admin_external_keys / key_type "pollination").
VEXIS_POLLINATION_API_KEY=
VEXIS_IMAGE_CONNECT_TIMEOUT=5
# Read budget for a render. Most finish in ~1-2s; raise only if your host
# sees cold starts, otherwise keep close to the 4-6s house rule.
VEXIS_IMAGE_TIMEOUT=6
VEXIS_IMAGE_COOLDOWN=15
VEXIS_IMAGE_MAX_BYTES=6291456

# --- Voice (ElevenLabs) --------------------------------------------------------
# One key serves both directions. The Watchdog panel stores them under the
# admin_external_keys types "elevenlabs_tts" and "elevenlabs_stt"; these
# variables are the self-hosted fallback (not yet read by ai.py).
VEXIS_ELEVENLABS_TTS_API_KEY=
VEXIS_ELEVENLABS_STT_API_KEY=

# --- Hugging Face Inference ----------------------------------------------------
# Backup image/text inference, free tier. Not yet wired into a connector.
HF_API_TOKEN=

# --- Google Custom Search ------------------------------------------------------
# Server-side search needs BOTH the API key (from cloud.google.com -> Custom
# Search JSON API) and the cx id from programmable search. search_agent.py
# currently scrapes Google/DuckDuckGo HTML instead, so these are for the
# future JSON-API path.
VEXIS_GOOGLE_SEARCH_KEY=
VEXIS_GOOGLE_SEARCH_CX=

# --- IPGeolocation (optional) --------------------------------------------------
# Auto-detects a user's country. Free tier: 1,000 requests/day.
VEXIS_GEO_API_KEY=

# Public origin used for OAuth redirect URIs (https://yourapp.onbelmo.uk):
VEXIS_BASE_URL=

# --- Behaviour toggles -------------------------------------------------------
# 1 = skip the web Search Agent entirely (use on hosts where outbound
# scraping is blocked/slow, e.g. Belmo free). Chat then never blocks on search.
DISABLE_SEARCH=0
# Seconds the search agent may spend on outbound requests (default 14).
VEXIS_SEARCH_TIMEOUT=14

# Failover tuning (defaults: 3 attempts / 4s per request / 30s cooldown /
# 16s wall-clock budget per chat request; 0 disables the budget).
# 14 attempts x 8s used to exceed the 30s platform timeout.
VEXIS_MAX_PROVIDER_ATTEMPTS=3
VEXIS_REQUEST_TIMEOUT=4
VEXIS_PROVIDER_COOLDOWN=30
VEXIS_REQUEST_BUDGET=16

# Set to 1 on the server (Belmo). Refuses the local SQLite fallback.
VEXIS_PRODUCTION=1

# Engine auto-update: 1 = on (default). Downloads the latest official opencode
# windows-x64 build into .runtime\staging and renames it to vexis-runtime.exe;
# the new version activates at the next engine start. Previous binary kept as
# vexis-runtime.prev.exe, automatic rollback if the new engine fails health check.
VEXIS_AUTO_UPDATE=1
# Optional pin: never auto-update past this version.
VEXIS_ENGINE_PIN=
